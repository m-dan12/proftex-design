# Скопировать в .env на сервере (права 600). .env не попадает в git и в образ.

# Пусто — режим заглушки (тестовые картинки, фиктивные токены).
OPENAI_API_KEY=
# Подпись cookie-сессий; сгенерировать на сервере: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Том с app.db и папками results/, thumbs/, inputs/.
DATA_DIR=/data
# Администратор создаётся при пустой базе. Пароль генерируется на сервере, в чат не печатается.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# 1 — cookie с флагом Secure (прод за HTTPS); 0 — для локальной разработки по http.
COOKIE_SECURE=1
# Сколько запросов одновременно уходит в OpenAI.
MAX_PARALLEL=4
# Адреса прокси, которым доверяем X-Forwarded-For (через запятую, допускаются подсети). Адрес Caddy в Docker-сети.
TRUSTED_PROXIES=172.16.0.0/12
# Аварийный потолок трат всех пользователей за сутки (Europe/Moscow), USD. Пусто — без потолка.
SPEND_CAP_DAILY_USD=20
